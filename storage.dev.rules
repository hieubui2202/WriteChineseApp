rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /audio/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /stroke/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /lottie/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
