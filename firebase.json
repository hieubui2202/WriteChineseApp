{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "ignore": [
      "node_modules",
      ".git",
      ".firebase"
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "app",
      "public": "web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "predeploy": [
        "node tools/firebase/copy_admin_console.mjs"
      ],
      "headers": [
        {
          "source": "**/*.@(js|css|png|jpg|jpeg|svg|webp|json)",
          "headers": [
            { "key": "Cache-Control", "value": "public,max-age=604800,immutable" }
          ]
        },
        {
          "source": "_admin/**",
          "headers": [
            { "key": "Cache-Control", "value": "no-store" },
            { "key": "X-Robots-Tag", "value": "noindex" }
          ]
        }
      ],
      "rewrites": [
        { "source": "_admin/**", "destination": "_admin/index.html" }
      ]
    }
  ]
}
